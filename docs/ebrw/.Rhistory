install_github("jennywadsworth/geometricMVE")
library(geometricMVE)
library(mvtnorm)
library(evd)
library(geometricMVE)
library(VGAM)
library(colorspace)
install.packages("qgam")
############# HIGH QUANTILE DIAGNOSTICS
#DATASET 4
library(mvtnorm)
par(mfrow=c(1,1))
n<-10000
rho<-0.9
sigma2<- matrix(c(1,rho,rho,rho,1,rho,rho,rho,1),3,3)
set.seed(12345); x_gauss_exp_3d<-qexp(pnorm(rmvnorm(n=n,sigma=sigma2)))
r_gauss_exp_3d<-apply(x_gauss_exp_3d,1,sum)
w_gauss_exp_3d<-x_gauss_exp_3d/r_gauss_exp_3d
library(rgl)
# Define number of points to sample in the simplex (creating a grid)
num_points <- 300  # Increase for finer resolution
# Generate a meshgrid of points (w1, w2) within the 2-simplex
w1_seq <- seq(0, 1, length.out = num_points)
w2_seq <- seq(0, 1, length.out = num_points)
# Create a grid of points (w1, w2)
grid <- expand.grid(w1 = w1_seq, w2 = w2_seq)
# Enforce simplex constraint: w1 + w2 <= 1
grid$w2 <- pmin(grid$w2, 1 - grid$w1)  # ensure w1 + w2 <= 1
g_gaussian_out_AQR_comp<-c()
for(i in 1:length(grid[,1])){
g_gaussian_out_AQR_comp[i]<-gauge_gaussian(t(cbind(grid[i,],1-sum(grid[i,]))),par=c(0.9,0.9,0.9)) #0.9 is dependence parameter for dataset 1
} #this is just the gaussian gauge can be reused for KDE example
library(geometricMVE)
library(colorspace)
library(ggplot2)
library(ggtern)
g_gaussian_out_AQR_comp<-c()
for(i in 1:length(grid[,1])){
g_gaussian_out_AQR_comp[i]<-gauge_gaussian(t(cbind(grid[i,],1-sum(grid[i,]))),par=c(0.9,0.9,0.9)) #0.9 is dependence parameter for dataset 1
} #this is just the gaussian gauge can be reused for KDE example
C_tauvect_gaussian_d3 <- function(w, tau=0.9, Sigma=sigma2){ #generate corresponding C_tau for gaussian model
#Assumes d=3
alpha = 1.5 + (t(sqrt(w)) %*% solve(Sigma) %*% (sqrt(w)))/2
return(qgamma(tau,shape=alpha,rate=1))
} #Again can be reduced for KDE example
C_tauvect_gaussian_out<-matrix(ncol=1,nrow=length(grid[,1]))
for(i in 1:length(grid[,1])){
C_tauvect_gaussian_out[i,] <- C_tauvect_gaussian_d3(t(cbind(grid[i,],1-sum(grid[i,]))))
} #Matrix of C taus for varying angle
fit_3d_grid_thresh.out <-geometricMVE::fit.thresh(r_gauss_exp_3d,w_gauss_exp_3d, tau=0.9,method="empirical", overlap=0.15, bin.mesh=20) #use default parameters
r.hat_EB_RW <- geometricMVE::eval.thresh(fit_3d_grid_thresh.out,w.eval=cbind(grid,w3=1-grid$w1-grid$w2)) #use default overlap/mesh size parameters
#3d surface plot
options(rgl.printRglwidget = TRUE)
open3d()
plot3d(x_gauss_exp_3d, pch=20, col="grey",xlab="x", ylab="y",zlab="z")
# Reshape x, y, z into matrices to match the grid
x_matrix <- matrix(r.hat_EB_RW * grid$w1, nrow = num_points, ncol = num_points)
y_matrix <- matrix(r.hat_EB_RW * grid$w2, nrow = num_points, ncol = num_points)
z_matrix <- matrix(r.hat_EB_RW * (1 - grid$w1 - grid$w2), nrow = num_points, ncol = num_points)
# Plot the 3D surface using rgl's surface3d
# Surface is plotted with x_matrix, y_matrix, and z_matrix
surface3d(x_matrix, y_matrix, z_matrix, col = "#734496", alpha = 0.7)  # Add surface, adjust color/opacity as needed
# Optional: Add axes and title
axes3d()
title3d(main = "90% quantile EB/RW Surface")
diagnostic_EB_RW_surface <- r.hat_EB_RW - C_tauvect_gaussian_out/g_gaussian_out_AQR_comp
df <- data.frame(
w1 = grid[,1],
w2 = grid[,2],
w3 = 1- grid[,1] -grid[,2],
z  = diagnostic_EB_RW_surface
)
# --- Plot ---
ggtern(df, aes(x = w1, y = w2, z = w3, color = z)) +
geom_point(size = 2) +
#Sequential colour gradient for comparison
scale_color_gradientn(
colours = diverging_hcl(100, palette = "Purple-Green"),
name = "Diagnostic"
) +
theme_minimal() +
theme(
legend.position = "right",
tern.axis.title.T = element_text(size = 12),
tern.axis.title.L = element_text(size = 12),
tern.axis.title.R = element_text(size = 12)
) +
labs(
title = "Diagnostic for 90% EB/RW quantile surface on Unit Simplex"
)
citation("geometricMVE")
############# HIGH QUANTILE DIAGNOSTICS
#DATASET 4
library(mvtnorm)
par(mfrow=c(1,1))
n<-10000
rho<-0.9
sigma2<- matrix(c(1,rho,rho,rho,1,rho,rho,rho,1),3,3)
set.seed(12345); x_gauss_exp_3d<-qexp(pnorm(rmvnorm(n=n,sigma=sigma2)))
r_gauss_exp_3d<-apply(x_gauss_exp_3d,1,sum)
w_gauss_exp_3d<-x_gauss_exp_3d/r_gauss_exp_3d
library(rgl)
options(rgl.printRglwidget = TRUE)
open3d()
plot3d(x_gauss_exp_3d, pch=20, col="grey",xlab="x", ylab="y",zlab="z")
#EXPONENTIAL MARGINS
DATA <- data.frame(r = r_gauss_exp_3d, w1 = w_gauss_exp_3d[, 1], w2 = w_gauss_exp_3d[,2])
# Fit quantile regression model
library(qgam)
fit.gauss_exp_qgam <- mqgam(r ~ s(w1,w2, k=50), data = DATA, qu = tauvect[5])
# Define number of points to sample in the simplex (creating a grid)
num_points <- 300  # Increase for finer resolution
# Generate a meshgrid of points (w1, w2) within the 2-simplex
w1_seq <- seq(0, 1, length.out = num_points)
w2_seq <- seq(0, 1, length.out = num_points)
# Create a grid of points (w1, w2)
grid <- expand.grid(w1 = w1_seq, w2 = w2_seq)
# Enforce simplex constraint: w1 + w2 <= 1
grid$w2 <- pmin(grid$w2, 1 - grid$w1)  # ensure w1 + w2 <= 1
# Compute the predicted values (r) for each grid point
pred_r <- numeric(nrow(grid))  # Initialize the vector to store predictions
for(j in 1:nrow(grid)){
pred_r[j] <- qdo(fit.gauss_exp_qgam, tauvect[5], predict, newdata = grid[j, , drop = FALSE])
}
# Compute the 3D coordinates
x <- pred_r * grid$w1
y <- pred_r * grid$w2
z <- pred_r * (1 - grid$w1 - grid$w2)
# Reshape x, y, z into matrices to match the grid
x_matrix <- matrix(x, nrow = num_points, ncol = num_points)
y_matrix <- matrix(y, nrow = num_points, ncol = num_points)
z_matrix <- matrix(z, nrow = num_points, ncol = num_points)
# Plot the 3D surface using rgl's surface3d
# Surface is plotted with x_matrix, y_matrix, and z_matrix
surface3d(x_matrix, y_matrix, z_matrix, col = "purple", alpha = 0.7)  # Add surface, adjust color/opacity as needed
# Optional: Add axes and title
axes3d()
title3d(main = "90% quantile AQR Surface")
htmlwidgets::saveWidget(widget, "index.html", selfcontained = TRUE)
