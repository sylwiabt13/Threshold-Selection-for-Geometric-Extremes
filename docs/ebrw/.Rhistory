edge3 <- cbind(seq(-1, 0, length.out = n), seq(0, -1, length.out = n))
edge4 <- cbind(seq(0, 1, length.out = n), seq(-1, 0, length.out = n)) # Combine into full shape
wpts_l <- rbind(edge1, edge2, edge3, edge4)
