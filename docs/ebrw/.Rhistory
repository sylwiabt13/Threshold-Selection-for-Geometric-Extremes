KDE.thresh.eval_lap = function(wpts,r,w,tau=0.95,bww=0.05,bwr=0.05,up=30, tol=0.01){
require(mvtnorm)
n.dims = dim(w)[2]
F_bwr_minus_r <- pnorm(0,mean=r,sd=bwr) #kernel renormalisation (basically negligible, but I am keeping it in)
