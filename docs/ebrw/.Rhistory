tau_colors <- function(x, palette = "Viridis", n = 100) {
pal <- sequential_hcl(n, palette = palette)
x_norm <- (x - min(x)) / diff(range(x))
cols <- pal[round(x_norm * (n - 1)) + 1]
names(cols) <- x
cols
}
tau.col <- tau_colors(tauvect)
tau.col2 <- tau_colours(tauvect, palette= "Magma")
tauvect <- c(0.5, 0.6, 0.7, 0.8, 0.9, 0.95, 0.98)
tau_colours <- function(x, palette = "Viridis", n = 100) {
pal <- sequential_hcl(n, palette = palette)
x_norm <- (x - min(x)) / diff(range(x))
cols <- pal[round(x_norm * (n - 1)) + 1]
names(cols) <- x
cols
}
tau.col <- tau_colours(tauvect)
tau.col2 <- tau_colours(tauvect, palette= "Magma")
tau.col <- tau_colours(tauvect)
tau.col2 <- tau_colours(tauvect, palette= "Inferno")
