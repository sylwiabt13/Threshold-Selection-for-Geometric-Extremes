}
n.dims = dim(w)[2]
F_bwr_minus_r <- pnorm(0,mean=r,sd=bwr) #kernel renormalisation (basically negligible, but I am keeping it in)
r.tau.wpts = apply(wpts,1,function(wpts.i){
if(abs(sum(abs(wpts.i)) - 1) > tol){ #ensure we are on L1 sphere
return(NA) }
else{
weightsw = kernel_sphere(wpts.i)
ccdf<-function(rc){
mean(weightsw*((pnorm(rc,mean=r,sd=bwr)-F_bwr_minus_r)/(1-F_bwr_minus_r)))/mean(weightsw) #MODIFIED CODE
}
dummy<-function(rc){ccdf(rc) - tau} # want the root of this
is_error <- FALSE
tryCatch({ ur<-uniroot(dummy,interval = c(0,up))$root },
error=function(e){ is_error <<- TRUE })
if(is_error) { ur=NA }
return(ur) } })
return(r.tau.wpts) }
