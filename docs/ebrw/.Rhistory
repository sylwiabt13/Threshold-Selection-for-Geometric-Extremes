library(rgl)
############# HIGH QUANTILE DIAGNOSTICS
#DATASET 4
library(mvtnorm)
par(mfrow=c(1,1))
n<-10000
rho<-0.9
sigma2<- matrix(c(1,rho,rho,rho,1,rho,rho,rho,1),3,3)
set.seed(12345); x_gauss_exp_3d<-qexp(pnorm(rmvnorm(n=n,sigma=sigma2)))
r_gauss_exp_3d<-apply(x_gauss_exp_3d,1,sum)
w_gauss_exp_3d<-x_gauss_exp_3d/r_gauss_exp_3d
# Define number of points to sample in the simplex (creating a grid)
num_points <- 300  # Increase for finer resolution
# Generate a meshgrid of points (w1, w2) within the 2-simplex
w1_seq <- seq(0, 1, length.out = num_points)
w2_seq <- seq(0, 1, length.out = num_points)
# Create a grid of points (w1, w2)
grid <- expand.grid(w1 = w1_seq, w2 = w2_seq)
# Enforce simplex constraint: w1 + w2 <= 1
grid$w2 <- pmin(grid$w2, 1 - grid$w1)  # ensure w1 + w2 <= 1
KDE.thresh.eval.modified_exp = function(wpts,r,w,tau=0.95,bww=0.05,bwr=0.05,up=30){
require(mvtnorm)
n.dims = dim(w)[2]
F_bwr_minus_r <- pnorm(0,mean=r,sd=bwr) #kernel renormalisation
r.tau.wpts = apply(wpts,1,function(wpts.i){
if(sum(wpts.i)>1){
return(NA)
} else{
weightsw = dmvnorm(w[,-n.dims],mean=wpts.i[-n.dims],sigma=(bww^2)*diag(n.dims-1))
ccdf<-function(rc){
mean(weightsw*((pnorm(rc,mean=r,sd=bwr)-F_bwr_minus_r)/(1-F_bwr_minus_r)))/mean(weightsw)
}
dummy<-function(rc){ccdf(rc) - tau}  # want the root of this
is_error <- FALSE
tryCatch({
ur<-uniroot(dummy,interval = c(0,up))$root
},error=function(e){
is_error <<- TRUE
})
if(is_error) {
ur=NA
}
return(ur)
}
})
return(r.tau.wpts)
}
r.hat_KDE <- KDE.thresh.eval.modified_exp(wpts=cbind(grid,w3=1-grid$w1-grid$w2),
r=r_gauss_exp_3d,
w=w_gauss_exp_3d,
tau=0.9) #use default bandwidth parameters
#3d surface plot
options(rgl.printRglwidget = TRUE)
open3d()
plot3d(x_gauss_exp_3d, pch=20, col="grey",xlab="x", ylab="y",zlab="z")
# Reshape x, y, z into matrices to match the grid
x_matrix <- matrix(r.hat_KDE * grid$w1, nrow = num_points, ncol = num_points)
y_matrix <- matrix(r.hat_KDE * grid$w2, nrow = num_points, ncol = num_points)
z_matrix <- matrix(r.hat_KDE * (1 - grid$w1 - grid$w2), nrow = num_points, ncol = num_points)
# Plot the 3D surface using rgl's surface3d
# Surface is plotted with x_matrix, y_matrix, and z_matrix
surface3d(x_matrix, y_matrix, z_matrix, col = "purple", alpha = 0.7)  # Add surface, adjust color/opacity as needed
# Optional: Add axes and title
axes3d()
title3d(main = "90% quantile KDE Surface")
